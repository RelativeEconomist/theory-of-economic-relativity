// Static TER website Worker. Deploy from applications/web after `npm run build`:
// npx wrangler deploy
{
  "name": "theory-of-economic-relativity",
  "compatibility_date": "2026-10-10",
  // Wrangler replaces the Worker's custom domains with exactly this list.
  // Required in the Cloudflare account before release: redirect the apex to
  // www, because the simulator's CORS allows only the www origin.
  "routes": [
    { "pattern": "www.theoryofeconomicrelativity.com", "custom_domain": true },
    { "pattern": "theoryofeconomicrelativity.com", "custom_domain": true }
  ],
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
