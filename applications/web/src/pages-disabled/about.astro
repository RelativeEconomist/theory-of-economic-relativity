---
// Intentionally outside src/pages/ so this route is not built, served, or
// included in the sitemap. Kept as demo-content source for possible reuse.
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import Button from "../components/ui/Button.astro";
---
<BaseLayout title="About — Theory of Economic Relativity" description="A founder-focused strategy practice for turning distinct expertise into a clear market position.">
  <PageHero eyebrow="About the practice" title={'Independent thinking for <span class="serif">ambitious builders.</span>'} description="This is a fictional demonstration practice showing how a founder-led advisory brand can present its thinking, proof, and offer with clarity." note="All names, biographies, and outcomes are placeholder content." />
  <section class="section-sm divider"><div class="shell manifesto">
    <p class="eyebrow">The belief</p>
    <h2 data-reveal>People do not follow volume.<br/><span class="serif">They follow conviction.</span></h2>
    <div class="manifesto-copy" data-reveal>
      <p>Most founder-led companies do not have an attention problem. They have a signal problem. The insight is there, but it is spread across product decisions, customer conversations, and half-finished notes.</p>
      <p>Our work turns that insight into a clear commercial system: a position people remember, proof they can trust, and a voice that compounds over time.</p>
    </div>
  </div></section>
  <section class="section story"><div class="shell story-grid">
    <div class="portrait" data-reveal aria-label="Abstract placeholder portrait"><span>AM</span><i></i><b>PLACEHOLDER PORTRAIT</b></div>
    <div data-reveal><p class="eyebrow">Example founder story</p><h2>Built from the operator's side of the table.</h2><p class="lede">Avery Morgan is a fictional strategy advisor created to demonstrate the theme. Replace this biography, initials, and story in <code>src/pages/about.astro</code>.</p><p>After a decade helping technical teams bring complex products to market, Avery saw the same pattern: strong businesses obscured by generic language and disconnected growth activity. This practice was created as a focused alternative.</p><div class="button-row"><Button href="/contact/" label="Work together" /><Button href="/blog/" variant="ghost" label="Read the thinking" /></div></div>
  </div></section>
  <section class="section-sm principles"><div class="shell"><p class="eyebrow">Working principles</p><div class="principle-grid">
    <article data-reveal><span>01</span><h3>Truth before theatre</h3><p>Strategy starts with what is commercially true, not what sounds impressive in a workshop.</p></article>
    <article data-reveal><span>02</span><h3>Clarity is a decision</h3><p>Sharp communication follows sharp choices about who you serve and why your approach matters.</p></article>
    <article data-reveal><span>03</span><h3>Systems should compound</h3><p>Every asset should make the next one easier, stronger, and more recognizably yours.</p></article>
  </div></div></section>
</BaseLayout>

<style>
  .manifesto h2 { max-width: 65rem; }
  .manifesto-copy { display: grid; grid-template-columns: 1fr 1fr; gap: 3rem; width: min(100%,48rem); margin: 4rem 0 0 auto; color: var(--muted); }
  .story { background: var(--surface-2); }
  .story-grid { display: grid; grid-template-columns: .9fr 1.1fr; align-items: center; gap: clamp(3rem,8vw,8rem); }
  .story-grid > div:last-child > p:not(.eyebrow,.lede) { max-width: 38rem; color: var(--muted); }
  .portrait { position: relative; min-height: 38rem; overflow: hidden; display: grid; place-items: center; border-radius: 1.5rem; background: var(--violet); color: #171326; }
  .portrait span { position: relative; z-index: 2; font-family: var(--font-display); font-size: 8rem; font-style: italic; }
  .portrait i { position: absolute; width: 23rem; height: 23rem; border: 1px solid currentColor; border-radius: 50%; box-shadow: 0 0 0 4rem transparent,0 0 0 4.05rem currentColor; }
  .portrait b { position: absolute; right: 1rem; bottom: 1rem; font-size: .58rem; letter-spacing: .12em; }
  .principle-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 1rem; margin-top: 3rem; }
  .principle-grid article { min-height: 18rem; padding: 1.5rem; border: 1px solid var(--line); border-radius: 1.25rem; background: var(--surface); }
  .principle-grid span { color: var(--muted); font-size: .7rem; }.principle-grid h3 { margin-top: 4rem; }.principle-grid p { color: var(--muted); }
  @media (max-width: 800px) { .manifesto-copy,.story-grid,.principle-grid { grid-template-columns: 1fr; } .portrait { min-height: 28rem; } }
</style>
