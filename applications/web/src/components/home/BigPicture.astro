---
import SectionIntro from "../ui/SectionIntro.astro";
---
<section class="big-picture section-sm">
  <div class="shell">
    <SectionIntro title="Economic outcomes emerge from agent decisions." />

    <ol class="flow" aria-label="Agents, Decisions, Interactions, Outcomes, Feedback">
      <li class="flow-step" data-reveal>
        <span class="flow-index">01</span>
        <div class="flow-text">
          <h3>Agents</h3>
          <p>Individuals, businesses, governments, and organizations act in relation to objectives.</p>
        </div>
      </li>

      <li class="flow-step" data-reveal>
        <span class="flow-index">02</span>
        <div class="flow-text">
          <h3>Decisions</h3>
          <p>Agents choose from the actions they perceive as available.</p>
        </div>
      </li>

      <li class="flow-step" data-reveal>
        <span class="flow-index">03</span>
        <div class="flow-text">
          <h3>Interactions</h3>
          <p>Selected actions encounter reality and other agents.</p>
        </div>
      </li>

      <li class="flow-step" data-reveal>
        <span class="flow-index">04</span>
        <div class="flow-text">
          <h3>Outcomes</h3>
          <p>Those interactions produce economic outcomes.</p>
        </div>
      </li>

      <li class="flow-step" data-reveal>
        <span class="flow-index">05</span>
        <div class="flow-text">
          <h3>Feedback</h3>
          <p>Outcomes can change the conditions shaping future decisions.</p>
        </div>
      </li>
    </ol>
  </div>
</section>

<style>
  .big-picture {
    /* A stronger line than --line, so the timeline reads in both themes. */
    --flow-line: color-mix(in srgb, var(--ink) 38%, transparent);
    --marker: 2.25rem;
    --flow-gap: clamp(1.25rem, 2.5vw, 2rem);

    background: var(--surface-2);
  }

  .big-picture :global(.doc-heading) {
    font-size: clamp(1.85rem, 3vw, 3rem);
  }

  /* Main TER flow: five markers joined by one line, text below each. */

  .flow {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: var(--flow-gap);
    margin: clamp(2.25rem, 4.5vw, 3.5rem) 0 0;
    padding: 0;
    list-style: none;
  }

  .flow-step {
    position: relative;
    min-width: 0;
  }

  /* Each segment runs from this marker to the next; together they form
     one continuous line. */
  .flow-step:not(:last-child)::before {
    position: absolute;
    top: calc(var(--marker) / 2);
    left: var(--marker);
    width: calc(100% + var(--flow-gap) - var(--marker));
    height: 1px;
    background: var(--flow-line);
    content: "";
  }

  .flow-index {
    display: inline-grid;
    width: var(--marker);
    height: var(--marker);
    place-items: center;
    border: 1px solid var(--flow-line);
    border-radius: 50%;
    background: var(--surface-2);
    color: var(--ink);
    font-size: 0.8rem;
    font-weight: 750;
    line-height: 1;
  }

  .flow-text {
    margin-top: 1rem;
  }

  .flow-step h3 {
    margin: 0;
    font-size: clamp(1.35rem, 1.8vw, 1.65rem);
    line-height: 1.1;
    letter-spacing: -0.025em;
  }

  .flow-step p {
    margin: 0.5rem 0 0;
    color: var(--muted);
    font-size: 0.95rem;
    line-height: 1.5;
  }

  @media (max-width: 900px) {
    /* Vertical line, with each marker beside its text. */
    .flow {
      grid-template-columns: 1fr;
      gap: 0;
    }

    .flow-step {
      display: grid;
      grid-template-columns: var(--marker) minmax(0, 1fr);
      column-gap: 1rem;
      padding-bottom: 1.5rem;
    }

    .flow-step:last-child {
      padding-bottom: 0;
    }

    .flow-step:not(:last-child)::before {
      top: var(--marker);
      bottom: 0;
      left: calc(var(--marker) / 2);
      width: 1px;
      height: auto;
    }

    .flow-text {
      margin-top: 0.4rem;
    }
  }
</style>
