---
import SectionIntro from "../ui/SectionIntro.astro";

/* Abstract artwork only; the stage meaning is carried by the HTML text. */

// Decision process: an open, triangulated network of eight nodes.
const netNodes = [
  [8, 58], [40, 18], [52, 84], [88, 44], [96, 104], [128, 16], [140, 72], [176, 64],
];
const netEdges = [
  [0, 1], [0, 2], [1, 2], [1, 3], [2, 3], [2, 4], [3, 4],
  [3, 5], [3, 6], [4, 6], [5, 6], [5, 7], [6, 7],
];

// Reality: a 170 x 100 rectangle divided into irregular triangles.
const m: Record<string, [number, number]> = {
  A: [0, 0], B: [52, 0], C: [118, 0], D: [170, 0],
  E: [0, 46], F: [58, 40], G: [132, 30], H: [170, 58],
  I: [30, 74], J: [104, 62],
  K: [0, 100], L: [34, 100], M: [96, 100], N: [140, 100], O: [170, 100],
};
const meshTriangles = [
  "ABF", "AFE", "BCF", "CGF", "CDG", "DHG", "GHJ", "FGJ", "EFI",
  "FJI", "EIK", "KIL", "ILM", "IMJ", "JMN", "JNH", "HNO",
];
const meshPath = meshTriangles
  .map((t) => "M" + [...t].map((k) => m[k].join(" ")).join(" L") + " Z")
  .join(" ");
---

<section class="section-sm process">
  <div class="shell">
    <SectionIntro
      eyebrow=""
      title="Agents choose from perceived possibilities"
    />

    <div class="stages" role="list" aria-label="Decision process, action selected, reality, outcome" data-reveal>
      <div class="stage" role="listitem">
        <div class="art" aria-hidden="true">
          <!-- Link: network's right node (176, 74) to the lime node. -->
          <svg class="link" style="--from: 176px; --to: 48px;" viewBox="0 0 100 140" preserveAspectRatio="none">
            <path d="M0 74 C45 74 55 90 100 90" />
          </svg>
          <svg class="illus" style="--w: 180px; --h: 120px; --top: 10px;" viewBox="-3 -3 186 126">
            <path class="wire" d={netEdges.map(([a, b]) => `M${netNodes[a].join(" ")} L${netNodes[b].join(" ")}`).join(" ")} />
            {netNodes.map(([x, y]) => <circle class="node" cx={x} cy={y} r="2.5" />)}
          </svg>
        </div>
        <h3>Decision process</h3>
        <ul class="inputs">
          <li>Perceived feasible actions</li>
          <li>Model of reality</li>
          <li>Valuation (objective, time horizon)</li>
        </ul>
      </div>

      <div class="stage" role="listitem">
        <div class="art" aria-hidden="true">
          <!-- Link: lime node (48, 90) to the mesh's left edge. -->
          <svg class="link" style="--from: 48px; --to: 0px;" viewBox="0 0 100 140" preserveAspectRatio="none">
            <path d="M0 90 C45 90 55 66 100 66" />
          </svg>
          <svg class="illus selected" style="--w: 14px; --h: 14px; --top: 83px; --left: 41px;" viewBox="0 0 14 14">
            <circle cx="7" cy="7" r="6.4" />
          </svg>
        </div>
        <h3>Action selected</h3>
        <p>From that environment, the agent selects an action from what it perceives as possible.</p>
      </div>

      <div class="stage" role="listitem">
        <div class="art" aria-hidden="true">
          <!-- Link: the mesh's right edge (170, 78) to the outer ring. -->
          <svg class="link" style="--from: 170px; --to: 1px;" viewBox="0 0 100 140" preserveAspectRatio="none">
            <path d="M0 78 C45 78 55 70 100 70" />
          </svg>
          <svg class="illus" style="--w: 170px; --h: 100px; --top: 20px;" viewBox="-1 -1 172 102">
            <path class="wire" d={meshPath} />
          </svg>
        </div>
        <h3>Reality</h3>
        <p>That selected action then encounters the objective conditions and constraints of reality, which the agent may perceive imperfectly.</p>
      </div>

      <div class="stage" role="listitem">
        <div class="art" aria-hidden="true">
          <svg class="illus" style="--w: 80px; --h: 80px; --top: 30px;" viewBox="0 0 80 80">
            <circle class="wire" cx="40" cy="40" r="39" />
            <circle class="wire" cx="40" cy="40" r="23" />
            <circle class="node" cx="40" cy="40" r="3.5" />
          </svg>
        </div>
        <h3>Outcome</h3>
        <p>From that interaction, a realized outcome follows.</p>
      </div>
    </div>
  </div>
</section>

<style>
  .process {
    /* Artwork scale. Sizes and anchors below are written at full size
       and multiplied by --s. */
    --s: 0.7;
    --band: calc(140px * var(--s));
    --stage-gap: clamp(1.5rem, 3vw, 2.5rem);
    /* Neutral wireframe tones, derived from --muted so they hold in both
       themes. The connecting line is a step lighter than the artwork. */
    --wire: color-mix(in srgb, var(--muted) 62%, transparent);
    --wire-node: color-mix(in srgb, var(--muted) 85%, transparent);
    --link: color-mix(in srgb, var(--muted) 40%, transparent);

    overflow: hidden;
  }

  .stages {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) repeat(3, minmax(0, 1fr));
    gap: var(--stage-gap);
    margin-top: clamp(2.25rem, 4.5vw, 3.5rem);
  }

  .stage {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    min-width: 0;
  }

  /* Fixed-height band so the headings line up across columns. */
  .art {
    position: relative;
    height: var(--band);
    margin-bottom: 0.75rem;
  }

  .illus {
    position: absolute;
    z-index: 1;
    top: calc(var(--top, 0px) * var(--s));
    left: calc(var(--left, 0px) * var(--s));
    width: calc(var(--w) * var(--s));
    height: calc(var(--h) * var(--s));
    overflow: visible;
  }

  /* Each link runs from an anchor in its own column to an anchor in the
     next column; together they read as one continuous curve. */
  .link {
    position: absolute;
    top: 0;
    left: calc(var(--from) * var(--s));
    /* SVG ignores left + right for sizing, so set the width directly. */
    width: calc(100% - var(--from) * var(--s) + var(--stage-gap) + var(--to) * var(--s));
    /* Links cross into the next column, so lift the base max-width cap. */
    max-width: none;
    height: var(--band);
    overflow: visible;
  }

  .link path {
    fill: none;
    stroke: var(--link);
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }

  .wire {
    fill: none;
    stroke: var(--wire);
    stroke-width: 1;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
  }

  .node {
    fill: var(--wire-node);
  }

  /* The lime accent marks only the selected action. */
  .selected circle {
    fill: var(--accent);
    stroke: color-mix(in srgb, var(--ink) 45%, transparent);
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }

  .stage h3 {
    margin: 0;
    color: var(--muted);
    font-size: 1.05rem;
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: -0.005em;
  }

  .stage p {
    margin: 0;
  }

  .inputs {
    display: grid;
    gap: 0.35rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (max-width: 900px) {
    .process {
      --s: 0.49;
    }

    .stages {
      grid-template-columns: minmax(0, 1fr);
      gap: 2.5rem;
    }

    .link {
      display: none;
    }

    /* Compact, consistent illustration rows. */
    .art {
      display: flex;
      align-items: center;
      height: 3.85rem;
      margin-bottom: 0.25rem;
    }

    .illus {
      position: static;
    }

    /* The lime node keeps its relative size on mobile. */
    .illus.selected {
      width: calc(var(--w) * 0.7);
      height: calc(var(--h) * 0.7);
    }
  }
</style>
