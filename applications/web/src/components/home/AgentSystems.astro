---
import SectionIntro from "../ui/SectionIntro.astro";
---

<section class="section process">
  <div class="shell">
    <SectionIntro
      eyebrow=""
      title="Individual decisions become system outcomes."
      description="One agent's actions can change the information, incentives, constraints, and opportunities faced by others. Those interactions can combine into outcomes no single agent determines alone."
    />

    <div class="process-layout">
      <div class="dial" data-reveal aria-hidden="true">
        <img class="agent-graph" src="/images/ter-organic-network-mesh-square.svg" alt="" />
      </div>
    </div>
  </div>
</section>

<style>
  .process {
    overflow: hidden;
  }

  .process-layout {
    display: grid;
    grid-template-columns: 1fr;
    align-items: center;
    margin-top: clamp(4rem, 8vw, 7rem);
  }

  .agent-graph {
  width: 115%;
  max-width: none;
  transform: translateX(-6.5%);
}

  .dial {
    position: relative;
    width: min(100%, 29rem);
    aspect-ratio: 1;
    margin: auto;
  }

  .agent-graph {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .edge {
    stroke: var(--line);
    stroke-width: 1.2;
  }

  .edge-contrib {
    stroke: color-mix(in srgb, var(--muted) 55%, var(--line));
    stroke-width: 1.4;
  }

  .node {
    fill: var(--surface);
    stroke: var(--line);
    stroke-width: 2;
  }

  .node-accent {
    fill: var(--accent);
    stroke: var(--accent);
  }

  .node-violet {
    fill: var(--violet);
    stroke: var(--violet);
  }

  .node-orange {
    fill: var(--orange);
    stroke: var(--orange);
  }

  .core {
    fill: var(--ink);
  }

  .core-label {
    fill: var(--bg);
    font-size: 8px;
    font-weight: 750;
    letter-spacing: -0.02em;
    text-transform: uppercase;
  }

  @media (max-width: 800px) {
    .dial {
      width: min(88vw, 24rem);
    }
  }
</style>