---
import Button from "../ui/Button.astro";
---
<section class="section-sm open-science">
  <div class="shell open-science-inner">
    <p class="label" data-reveal>Open science</p>
    <h2 class="doc-heading" data-reveal>Read it. Test it. Challenge it. Improve it.</h2>
    <p class="lede" data-reveal>
      TER brings together a formal theory, a working simulation framework, and documented reproductions of established economic models. Developed through extensive testing and adversarial review, it is open for anyone to reproduce results, examine assumptions, and challenge its scope and usefulness.
    </p>
    <div class="button-row" data-reveal>
      <Button href="/theory/" label="Read the theory" variant="dark" />
      <Button href="/learn/" label="Explore the models" variant="ghost" />
      <Button href="/participate/" label="Review or participate" variant="ghost" />
    </div>
  </div>
</section>

<style>
  .open-science { background: var(--accent); color: var(--accent-ink); }

  .label {
    margin: 0 0 1.25rem;
    font-size: .76rem;
    font-weight: 700;
    letter-spacing: .1em;
    text-transform: uppercase;
    opacity: .7;
  }

  .lede {
    color: var(--accent-ink);
    opacity: .85;
  }

  .lede-secondary {
    max-width: 50rem;
    margin: 2rem 0 0;
    color: var(--muted);
    font-size: 1.1rem;
    line-height: 1.6;
    opacity: .85;
  }

  .open-science :global(.button-ghost) {
    border-color: color-mix(in srgb, var(--accent-ink) 30%, transparent);
    color: var(--accent-ink);
  }
</style>
