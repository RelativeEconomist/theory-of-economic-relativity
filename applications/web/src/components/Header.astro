---
import Logo from "./ui/Logo.astro";
import Button from "./ui/Button.astro";
import { siteConfig } from "../config/site";

const path = Astro.url.pathname;
---
<header class="site-header" data-header>
  <div class="nav-shell">
    <span class="logo-slot logo-slot-light"><Logo /></span>
    <span class="logo-slot logo-slot-dark"><Logo variant="white" /></span>
    <nav class="desktop-nav" aria-label="Primary navigation">
      {siteConfig.nav.map((item) => (
        <a
          class:list={{ active: item.href === "/" ? path === "/" : path.startsWith(item.href) }}
          href={item.href}
          target={item.external ? "_blank" : undefined}
          rel={item.external ? "noreferrer" : undefined}
        >
          {item.label}
        </a>
      ))}
    </nav>
    <div class="nav-actions">
      <button class="icon-button" type="button" data-theme-toggle aria-label="Switch color theme">
        <svg class="sun" aria-hidden="true" viewBox="0 0 24 24"><circle cx="12" cy="12" r="3.5"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
        <svg class="moon" aria-hidden="true" viewBox="0 0 24 24"><path d="M20.5 15.2A8.5 8.5 0 0 1 8.8 3.5a8.5 8.5 0 1 0 11.7 11.7Z"/></svg>
      </button>
      <button class="menu-toggle" type="button" data-menu-toggle aria-expanded="false" aria-controls="mobile-menu">
        <span class="sr-only">Open menu</span><i></i><i></i>
      </button>
    </div>
  </div>
  <div class="mobile-menu" id="mobile-menu" data-mobile-menu aria-hidden="true">
    <nav aria-label="Mobile navigation">
      {siteConfig.nav.map((item, index) => (
        <a
          href={item.href}
          target={item.external ? "_blank" : undefined}
          rel={item.external ? "noreferrer" : undefined}
        >
          <span>0{index + 1}</span>{item.label}
        </a>
      ))}
    </nav>
    <div class="mobile-bottom">
      <p>Questions about TER?</p>
      <Button href="/contact/" label="Get in touch" />
    </div>
  </div>
</header>

<script>
  import { animate } from "motion";

  const initHeader = () => {
    const header = document.querySelector<HTMLElement>("[data-header]");
    const menuButton = document.querySelector<HTMLButtonElement>("[data-menu-toggle]");
    const menu = document.querySelector<HTMLElement>("[data-mobile-menu]");
    const themeButton = document.querySelector<HTMLButtonElement>("[data-theme-toggle]");
    if (!header || !menuButton || !menu || !themeButton) return;
    if (header.dataset.bound) return;
    header.dataset.bound = "true";

    const closeMenu = () => {
      document.body.classList.remove("menu-open");
      menuButton.setAttribute("aria-expanded", "false");
      menu.setAttribute("aria-hidden", "true");
      header.classList.remove("is-open");
    };

    menuButton.addEventListener("click", () => {
      const open = menuButton.getAttribute("aria-expanded") !== "true";
      menuButton.setAttribute("aria-expanded", String(open));
      menu.setAttribute("aria-hidden", String(!open));
      header.classList.toggle("is-open", open);
      document.body.classList.toggle("menu-open", open);
      if (open) animate(menu.querySelectorAll("nav a"), { opacity: [0, 1], y: [18, 0] }, { duration: .42, delay: (i) => i * .045, ease: [.4, 0, .2, 1] });
    });
    menu.querySelectorAll("a").forEach((link) => link.addEventListener("click", closeMenu));
    window.addEventListener("keydown", (event) => { if (event.key === "Escape") closeMenu(); });
    window.addEventListener("resize", () => { if (window.innerWidth > 900) closeMenu(); });

    themeButton.addEventListener("click", () => {
      const next = document.documentElement.dataset.theme === "dark" ? "light" : "dark";
      document.documentElement.dataset.theme = next;
      localStorage.setItem("ter-theme", next);
      themeButton.setAttribute("aria-label", `Switch to ${next === "dark" ? "light" : "dark"} theme`);
      animate(themeButton, { rotate: [0, 20, 0], scale: [1, .88, 1] }, { duration: .38, ease: [.4, 0, .2, 1] });
    });

    const updateHeader = () => header.classList.toggle("scrolled", window.scrollY > 20);
    updateHeader();
    window.addEventListener("scroll", updateHeader, { passive: true });
  };
  initHeader();
  document.addEventListener("astro:page-load", initHeader);
</script>

<style>
.nav-shell {
  width: min(100%, 1320px);
  min-height: 4.25rem;
  margin: auto;
  display: flex;
  align-items: center;
  padding: .55rem .65rem .55rem 1rem;
  border: 1px solid transparent;
  border-radius: 999px;
  pointer-events: auto;
  transition: background .35s var(--ease), border-color .35s var(--ease), box-shadow .35s var(--ease);
}

.desktop-nav {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  margin-left: auto;
}

.nav-actions {
  display: flex;
  align-items: center;
  gap: .5rem;
  margin-left: .5rem;
}

  .site-header { position: fixed; z-index: 100; top: 0; left: 0; width: 100%; padding: .75rem; pointer-events: none; }
  .nav-shell { width: min(100%, 1320px); min-height: 4.25rem; margin: auto; display: flex; align-items: center; justify-content: space-between; padding: .55rem .65rem .55rem 1rem; border: 1px solid transparent; border-radius: 999px; pointer-events: auto; transition: background .35s var(--ease), border-color .35s var(--ease), box-shadow .35s var(--ease); }
  .scrolled .nav-shell, .is-open .nav-shell { border-color: var(--line); background: color-mix(in srgb, var(--bg) 94%, transparent); box-shadow: 0 8px 40px rgba(0,0,0,.08); backdrop-filter: blur(18px); }
  .desktop-nav a { position: relative; padding: .75rem .85rem; color: var(--muted); font-size: .86rem; font-weight: 650; transition: color .2s; }
  .desktop-nav a:hover, .desktop-nav a.active { color: var(--ink); }
  .desktop-nav a.active::after { position: absolute; right: .8rem; bottom: .4rem; left: .8rem; height: 2px; background: var(--accent); content: ""; }
  .nav-actions { display: flex; align-items: center; gap: .5rem; }
  .icon-button, .menu-toggle { width: 3rem; height: 3rem; display: grid; place-items: center; border: 1px solid var(--line); border-radius: 50%; color: var(--ink); cursor: pointer; }
  .icon-button svg { width: 1.15rem; fill: none; stroke: currentColor; stroke-width: 1.6; stroke-linecap: round; }
  .moon, html[data-theme="dark"] .sun { display: none; }
  html[data-theme="dark"] .moon { display: block; }
  .logo-slot { display: contents; }
  .logo-slot-dark :global(.logo) { display: none; }
  html[data-theme="dark"] .logo-slot-light :global(.logo) { display: none; }
  html[data-theme="dark"] .logo-slot-dark :global(.logo) { display: inline-flex; }
  .menu-toggle { display: none; gap: 5px; align-content: center; }
  .menu-toggle i { width: 1.1rem; height: 1px; background: currentColor; transition: transform .3s var(--ease); }
  .is-open .menu-toggle i:first-of-type { transform: translateY(3px) rotate(45deg); }
  .is-open .menu-toggle i:last-of-type { transform: translateY(-3px) rotate(-45deg); }
  .mobile-menu { display: none; }
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0,0,0,0); }
  @media (max-width: 900px) {
    .site-header { padding: .5rem; }
    .nav-shell { min-height: 3.85rem; border-color: var(--line); background: var(--bg); box-shadow: 0 8px 30px rgba(0,0,0,.07); }
    .desktop-nav, .desktop-cta { display: none; }
    .menu-toggle { display: grid; }
    .mobile-menu { position: fixed; z-index: -1; inset: 0; display: flex; visibility: hidden; flex-direction: column; justify-content: space-between; padding: 7.5rem 1.25rem 1.25rem; background: var(--bg); opacity: 0; pointer-events: none; transition: opacity .3s var(--ease), visibility .3s; }
    .is-open .mobile-menu { visibility: visible; opacity: 1; pointer-events: auto; }
    .mobile-menu nav { display: grid; border-top: 1px solid var(--line); }
    .mobile-menu nav a { display: flex; align-items: baseline; gap: 1rem; padding: .75rem 0; border-bottom: 1px solid var(--line); font-size: clamp(2rem, 11vw, 4rem); font-weight: 600; letter-spacing: -.055em; line-height: 1.1; }
    .mobile-menu nav span { color: var(--muted); font-size: .67rem; font-weight: 700; letter-spacing: .08em; }
    .mobile-bottom { display: grid; gap: .75rem; }
    .mobile-bottom p { margin: 0; color: var(--muted); }
  }
</style>
