---
<ul class="social-links">
  {siteConfig.social.map((account) => (
    <li>
      <a
        href={account.href}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={`TER on ${account.label} (opens in a new tab)`}
        title={account.label}
      >
        <svg aria-hidden="true" focusable="false" viewBox="0 0 24 24">
          <path d={icons[account.icon]} />
        </svg>
      </a>
    </li>
  ))}
</ul>

<style>
  .social-links { display: flex; flex-wrap: wrap; gap: .5rem; margin: 0; padding: 0; list-style: none; }
  .social-links a { display: grid; place-items: center; width: 2.25rem; height: 2.25rem; border: 1px solid #30342c; border-radius: 50%; color: #cdd1c8; transition: color .2s, border-color .2s; }
  .social-links a:hover { color: var(--accent); border-color: var(--accent); }
  .social-links a:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; color: var(--accent); }
  .social-links svg { width: 1rem; height: 1rem; fill: currentColor; }
</style>
