---
interface Props {
  compact?: boolean;
  variant?: "default" | "white";
}

const {
  compact = false,
  variant = "default",
} = Astro.props;

const isWhite = variant === "white";

const colors = {
  ink: isWhite ? "#FFFFFF" : "#121410",
  green: isWhite ? "#FFFFFF" : "#5E7A67",
  lime: isWhite ? "#FFFFFF" : "#D9FF43",
  orange: isWhite ? "#FFFFFF" : "#FF6B35",
};

const title = isWhite ? "TER Monochrome White" : "TER";
---

<a class="logo" href="/" aria-label="Theory of Economic Relativity home">
  <svg
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 400 165"
    role="img"
    aria-label={title}
  >
    <title>{title}</title>

    <polygon fill={colors.ink} points="12,12 127,12 127,54 12,54" />
    <polygon fill={colors.ink} points="49,64 90,64 90,153 49,153" />

    <polygon fill={colors.ink} points="137,12 252,12 252,54 137,54" />
    <polygon fill={colors.green} points="138,64 175,64 175,104 138,104" />
    <polygon fill={colors.lime} points="182,64 220,64 220,104 182,104" />
    <polygon fill={colors.ink} points="137,114 252,114 252,153 137,153" />

    <polygon
      fill={colors.ink}
      points="380,12 262,12 262,152 300,152 302,46 341,46 342,80 380,80"
    />
    <polygon
      fill={colors.ink}
      points="311,90 311,103 340,152 388,152 353,90"
    />
    <polygon fill={colors.orange} points="310,57 333,57 333,81 310,81" />
  </svg>
</a>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
  }

  .logo svg {
    width: 9.5rem;
    height: auto;
    display: block;
    margin-left: 1rem;
  }
</style>