---
import type { ResultsTable, ScenarioField } from "../../data/learn/scenarios";
import Notation from "./Notation.astro";

interface Props {
  /** Omitted when the results are the activity, under its own heading. */
  heading?: string;
  /** Sentence after the heading, before the results. */
  intro?: string;
  results?: ScenarioField[];
  /** Comparison table across multiple cases, shown before any label/value list. */
  table?: ResultsTable;
  /** A short table that wraps to its container instead of scrolling. */
  fit?: boolean;
}

const { heading, intro, results, table, fit = false } = Astro.props;
---
<div class="scenario-results">
  {heading && <h3>{heading}</h3>}
  {intro && <p class="results-intro">{intro}</p>}

  {table && (
    <div class="results-table-wrap">
      <table class:list={["results-table", { fit }]}>
        <thead>
          <tr>{table.columns.map((column) => <th>{column}</th>)}</tr>
        </thead>
        <tbody>
          {table.rows.map((row) => (
            <tr>{row.map((cell) => <td><Notation text={cell} /></td>)}</tr>
          ))}
        </tbody>
      </table>
    </div>
  )}

  {results && (
    <dl class="results-grid">
      {results.map((result) => (
        <div>
          <dt>{result.label}</dt>
          <dd>{result.value}</dd>
        </div>
      ))}
    </dl>
  )}
</div>

<style>
  h3 {
    margin-top: 2.5rem;
  }

  .results-intro {
    max-width: 960px;
    margin: 1rem 0 0;
    color: var(--muted);
    font-size: 0.95rem;
    line-height: 1.55;
  }

  /* Reuses the same table treatment as .prose table in global.css, so a
     comparison table here matches the Theory doc's Markdown tables. */
  .results-table-wrap {
    margin: 1.5rem 0 0;
    overflow-x: auto;
  }

  .results-table {
    width: 100%;
    min-width: 32rem;
    border-collapse: collapse;
    font-size: 0.95rem;
  }

  .results-table.fit {
    min-width: 0;
  }

  .results-table th,
  .results-table td {
    padding: 0.65rem 0.9rem;
    border: 1px solid var(--line);
    text-align: left;
  }

  .results-table th {
    background: var(--surface-2);
    color: var(--ink);
    font-weight: 650;
  }

  .results-table td {
    color: var(--ink);
  }

  .results-grid {
    display: grid;
    gap: 0;
    margin: 1.5rem 0 0;
  }
  .results-grid > div {
    display: grid;
    grid-template-columns: 16rem 1fr;
    gap: 1.5rem;
    padding: 1rem 0;
    border-top: 1px solid var(--line);
  }

  .results-grid > div:last-child {
    border-bottom: 1px solid var(--line);
  }

  dt {
    color: var(--muted);
    font-size: 0.78rem;
    font-weight: 650;
    letter-spacing: 0.02em;
  }

  dd {
    margin: 0;
    color: var(--ink);
    font-size: 0.98rem;
    line-height: 1.55;
    white-space: pre-line;
  }

  @media (max-width: 640px) {
    .results-grid > div {
      grid-template-columns: 1fr;
      gap: 0.35rem;
    }
  }
</style>
