---
interface Props {
  assumptions: string[];
}

const { assumptions } = Astro.props;
// Source order is priority: the first few stay visible, the rest collapse.
const visibleAssumptions = assumptions.slice(0, 4);
const moreAssumptions = assumptions.slice(4);
---
<section class="scenario-assumptions doc-section">
  <h2 class="doc-heading">Assumptions</h2>

  <ul class="assumptions-list hairline-grid">
    {visibleAssumptions.map((assumption) => <li>{assumption}</li>)}
  </ul>

  {moreAssumptions.length > 0 && (
    <details class="disclosure">
      <summary>More assumptions</summary>
      <ul class="assumptions-list hairline-grid">
        {moreAssumptions.map((assumption) => <li>{assumption}</li>)}
      </ul>
    </details>
  )}
</section>

<style>
  .assumptions-list {
    margin: 2rem 0 0;
    padding: 0;
    list-style: none;
    border: 1px solid var(--line);
  }

  .disclosure {
    margin-top: 1rem;
  }

  .disclosure .assumptions-list {
    margin-top: 0;
  }

  .assumptions-list li {
    position: relative;
    min-width: 0;
    padding: 1.25rem 1.5rem 1.25rem 2.75rem;
    overflow-wrap: anywhere;
    color: var(--muted);
    font-size: 0.95rem;
    line-height: 1.6;
  }

  .assumptions-list li::before {
    content: "";
    position: absolute;
    top: 1.55rem;
    left: 1.5rem;
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 50%;
    background: var(--accent);
  }
</style>
