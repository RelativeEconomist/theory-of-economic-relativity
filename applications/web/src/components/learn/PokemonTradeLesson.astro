---
/**
 * Trade-or-sell choice exercise, the activity under the lesson's first
 * question. It records the reader's own answers in page memory only: nothing
 * is stored, sent, or run through the TER engine, and no choice is turned
 * into an outcome or recommendation. After the second choice it reveals the
 * lesson's takeaway and Model details, which the page renders hidden.
 */
import CollectionBinder from "./CollectionBinder.astro";

const TRADE = "trade";
const SELL = "sell";

const firstChoices = [
  { value: TRADE, title: "Trade with my friend", text: "Complete your collection now." },
  { value: SELL, title: "Try to sell for $115", text: "Receive money if you find a buyer." },
];

const secondChoices = [
  { value: TRADE, title: "Trade with my friend" },
  { value: SELL, title: "Try to sell for $115" },
];

const reasons = [
  "Completing my collection.",
  "Getting more money.",
  "Having a confirmed trade instead of an uncertain sale.",
  "Something else.",
];
---
<div class="pokemon-lesson" data-pokemon-lesson>
  <fieldset class="choice-fieldset" aria-labelledby="activity-heading">
    <div class="choice-grid">
      {firstChoices.map((choice) => (
        <label class="choice">
          <input type="radio" name="first-choice" value={choice.value} data-first />
          <span class="choice-body">
            <span class="choice-title">{choice.title}</span>
            <span class="choice-text">{choice.text}</span>
          </span>
        </label>
      ))}
    </div>
    <p class="fine-print">For this exercise, choose between these two options. Prices are illustrative, and selling fees are excluded.</p>
  </fieldset>

  <fieldset class="lesson-step" aria-labelledby="reason-question" data-reason-step hidden>
    <h2 class="step-heading" id="reason-question">What mattered most to you?</h2>
    <div class="choice-grid">
      {reasons.map((reason) => (
        <label class="choice">
          <input type="radio" name="reason" value={reason} data-reason />
          <span class="choice-body">
            <span class="choice-title">{reason}</span>
          </span>
        </label>
      ))}
    </div>
    <div class="lesson-buttons" data-reason-actions>
      <button class="button button-primary" type="button" data-continue disabled>Continue</button>
      <button class="button button-ghost" type="button" data-skip>Skip</button>
    </div>
  </fieldset>

  <div class="lesson-step" data-variation-step hidden>
    <div class="illustrated">
      <div>
        <h2 class="step-heading">Would one detail change your choice?</h2>
        <p>Imagine you already own the card your friend offered. The trade would no longer complete your collection. The estimated prices and the opportunity to try selling for $115 stay the same.</p>
      </div>
      <div class="illustration">
        <CollectionBinder owned label="The same binder page with that slot already filled, beside the same offered card." />
      </div>
    </div>
    <fieldset class="choice-fieldset">
      <legend class="choice-legend">What would you choose now?</legend>
      <div class="choice-grid">
        {secondChoices.map((choice) => (
          <label class="choice">
            <input type="radio" name="second-choice" value={choice.value} data-second />
            <span class="choice-body">
              <span class="choice-title">{choice.title}</span>
            </span>
          </label>
        ))}
      </div>
    </fieldset>
  </div>

  <div class="lesson-step" data-reveal-step hidden>
    <h2 class="step-heading">Your result</h2>
    <p data-changed hidden>You changed your choice.</p>
    <p data-unchanged hidden>You kept the same choice.</p>
    <dl class="answer-comparison">
      <div>
        <dt>Before</dt>
        <dd data-first-answer></dd>
      </div>
      <div>
        <dt>Now</dt>
        <dd data-second-answer></dd>
      </div>
    </dl>
    <p data-changed hidden>The prices stayed the same. The offered card no longer completed your collection, and you chose differently.</p>
    <p data-unchanged hidden>The offered card no longer completed your collection, but you still preferred <span data-kept-choice></span>. That change was not enough to change your choice.</p>
    <div class="lesson-buttons">
      <button class="button button-ghost" type="button" data-restart>Start again</button>
      <button class="button button-primary" type="button" data-explore>Explore the TER interpretation</button>
    </div>
  </div>

  <p class="sr-only" role="status" aria-live="polite" data-announcer></p>
</div>

<script>
  const CHOICE_LABELS: Record<string, string> = {
    trade: "Trade with my friend",
    sell: "Try to sell for $115",
  };

  const initLesson = () => {
    const root = document.querySelector<HTMLElement>("[data-pokemon-lesson]");
    if (!root || root.dataset.bound) return;
    root.dataset.bound = "true";

    const $ = <T extends HTMLElement>(selector: string) => root.querySelector<T>(selector)!;
    const radios = (selector: string) => [...root.querySelectorAll<HTMLInputElement>(selector)];
    const firstInputs = radios("[data-first]");
    const reasonInputs = radios("[data-reason]");
    const secondInputs = radios("[data-second]");
    const reasonStep = $("[data-reason-step]");
    const reasonActions = $("[data-reason-actions]");
    const continueButton = $<HTMLButtonElement>("[data-continue]");
    const variationStep = $("[data-variation-step]");
    const revealStep = $("[data-reveal-step]");
    const firstAnswer = $("[data-first-answer]");
    const secondAnswer = $("[data-second-answer]");
    const changed = [...root.querySelectorAll<HTMLElement>("[data-changed]")];
    const unchanged = [...root.querySelectorAll<HTMLElement>("[data-unchanged]")];
    const keptChoice = $("[data-kept-choice]");
    // The page's shared takeaway and TER interpretation, outside this activity.
    const takeaway = document.querySelector<HTMLElement>("[data-lesson-takeaway]")!;
    const interpretation = document.querySelector<HTMLElement>("[data-formal]")!;
    const interpretationHeading = document.querySelector<HTMLElement>("#formal-heading")!;
    const announcer = $("[data-announcer]");
    const firstQuestion = document.querySelector<HTMLElement>("#activity-heading")!;

    // The reader's answers, kept in page memory only. The first and second
    // choices answer different situations and are never merged; reason is
    // undefined when skipped.
    let answers: { first?: string; reason?: string; second?: string } = {};

    // Announces a newly revealed step without moving focus to it.
    const reveal = (step: HTMLElement) => {
      if (!step.hidden) return;
      step.hidden = false;
      announcer.textContent = step.querySelector("h2")?.textContent ?? "";
    };

    const showComparison = () => {
      const { first, second } = answers;
      if (!first || !second) return;
      firstAnswer.textContent = CHOICE_LABELS[first];
      secondAnswer.textContent = CHOICE_LABELS[second];
      for (const element of changed) element.hidden = first === second;
      for (const element of unchanged) element.hidden = first !== second;
      keptChoice.textContent = second === "sell" ? "trying to sell" : "trading";
    };

    const finishReasonStep = () => {
      reasonActions.hidden = true;
      reveal(variationStep);
    };

    for (const input of firstInputs) {
      input.addEventListener("change", () => {
        answers.first = input.value;
        showComparison();
        reveal(reasonStep);
      });
    }

    for (const input of reasonInputs) {
      input.addEventListener("change", () => {
        continueButton.disabled = false;
        // A reason picked after the step closes is still the stated reason.
        if (reasonActions.hidden) answers.reason = input.value;
      });
    }

    continueButton.addEventListener("click", () => {
      const selected = reasonInputs.find((input) => input.checked);
      if (!selected) return;
      answers.reason = selected.value;
      finishReasonStep();
    });

    $("[data-skip]").addEventListener("click", () => {
      answers.reason = undefined;
      for (const input of reasonInputs) input.checked = false;
      continueButton.disabled = true;
      finishReasonStep();
    });

    for (const input of secondInputs) {
      input.addEventListener("change", () => {
        answers.second = input.value;
        showComparison();
        if (revealStep.hidden) {
          reveal(revealStep);
          takeaway.hidden = false;
          interpretation.hidden = false;
        }
      });
    }

    $("[data-restart]").addEventListener("click", () => {
      answers = {};
      for (const input of [...firstInputs, ...reasonInputs, ...secondInputs]) input.checked = false;
      continueButton.disabled = true;
      reasonActions.hidden = false;
      for (const step of [reasonStep, variationStep, revealStep, takeaway, interpretation]) step.hidden = true;
      announcer.textContent = "";
      firstQuestion.focus();
    });

    $("[data-explore]").addEventListener("click", () => {
      interpretationHeading.scrollIntoView({ block: "start" });
      interpretationHeading.focus({ preventScroll: true });
    });
  };

  initLesson();
  document.addEventListener("astro:page-load", initLesson);
</script>

<style>
  [hidden] {
    display: none !important;
  }

  .lesson-step p {
    max-width: 55rem;
    margin: 1rem 0 0;
    line-height: 1.55;
    text-wrap: pretty;
  }

  /* Artwork sits beside the copy, never inside a choice, so neither option looks more appealing. */
  .illustrated {
    display: grid;
    grid-template-columns: minmax(0, 46rem) 15rem;
    gap: 2.5rem;
    align-items: center;
  }

  .illustrated > div {
    min-width: 0;
  }

  .lesson-step {
    min-width: 0;
    margin: 2.5rem 0 0;
    padding: 2rem 0 0;
    border: 0;
    border-top: 1px solid var(--line);
  }

  /* The h3 scale: the global h2 is sized for page sections, not questions. */
  .step-heading {
    max-width: 55rem;
    margin: 0;
    font-size: clamp(1.45rem, 2.4vw, 2rem);
    line-height: 1.08;
  }

  .choice-fieldset {
    min-width: 0;
    margin: 1.5rem 0 0;
    padding: 0;
    border: 0;
  }

  .choice-legend {
    padding: 0;
    font-weight: 650;
  }

  .choice-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    margin-top: 1.25rem;
  }

  .choice {
    position: relative;
    display: block;
    cursor: pointer;
  }

  /* The radio stays in the accessibility tree and keyboard order. */
  .choice input {
    position: absolute;
    width: 1px;
    height: 1px;
    opacity: 0;
  }

  .choice-body {
    display: grid;
    gap: 0.35rem;
    height: 100%;
    padding: 1rem 1.25rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    background: var(--surface);
    overflow-wrap: anywhere;
  }

  .choice:hover .choice-body {
    border-color: var(--ink);
  }

  .choice input:checked + .choice-body {
    border-color: var(--ink);
    background: var(--ink);
    color: var(--bg);
  }

  .choice input:focus-visible + .choice-body {
    outline: 3px solid var(--violet);
    outline-offset: 4px;
  }

  .choice-title {
    font-weight: 650;
  }

  .choice-text {
    color: var(--muted);
  }

  .choice input:checked + .choice-body .choice-text {
    color: inherit;
  }

  .fine-print {
    margin: 1rem 0 0;
  }

  .lesson-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.5rem;
  }

  .lesson-buttons .button:disabled {
    cursor: not-allowed;
    opacity: 0.6;
  }

  .answer-comparison {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    max-width: 55rem;
    gap: 1rem 2rem;
    margin: 1.25rem 0 0;
  }

  .answer-comparison dt {
    color: var(--muted);
    font-size: 0.78rem;
    font-weight: 650;
  }

  .answer-comparison dd {
    margin: 0.35rem 0 0;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
  }

  @media (max-width: 720px) {
    .illustrated {
      grid-template-columns: minmax(0, 1fr);
      gap: 1.25rem;
    }

    .illustration {
      width: min(100%, 12rem);
    }

    .choice-grid,
    .answer-comparison {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
