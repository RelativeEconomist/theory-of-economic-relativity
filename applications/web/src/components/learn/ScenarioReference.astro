---
/** Collapsed reference material: full variables, configuration, implementation, and theory links. */
import type { Scenario } from "../../data/learn/scenarios";
import TerVariableTable from "./TerVariableTable.astro";

interface Props {
  scenario: Scenario;
}

const { scenario } = Astro.props;
const sourceUrl = `https://github.com/RelativeEconomist/theory-of-economic-relativity/blob/main/${scenario.sourcePath}`;
---
<section class="scenario-reference doc-section">
  <h2 class="doc-heading">Deeper reference</h2>

  <div class="reference-list">
    {scenario.terComponents && (
      <details class="disclosure">
        <summary>TER variable definitions</summary>
        <TerVariableTable components={scenario.terComponents} />
      </details>
    )}

    {scenario.configuration && (
      <details class="disclosure">
        <summary>Test configuration</summary>
        <dl class="field-grid hairline-grid hairline-grid-cols-2">
          {scenario.configuration.map((field) => (
            <div>
              <dt>{field.label}</dt>
              <dd>{field.value}</dd>
            </div>
          ))}
        </dl>
      </details>
    )}

    {(scenario.implementationMapping || scenario.sourcePath) && (
      <details class="disclosure">
        <summary>Implementation and source</summary>
        {scenario.implementationMapping && (
          <>
            <p class="reference-note">Python fields in the scenario module and the TER variable each specifies.</p>
            <dl class="field-grid hairline-grid hairline-grid-cols-2">
              {scenario.implementationMapping.map((field) => (
                <div>
                  <dt><code>{field.label}</code></dt>
                  <dd>{field.value}</dd>
                </div>
              ))}
            </dl>
          </>
        )}
        {scenario.sourcePath && (
          <p class="scenario-source">
            <a href={sourceUrl} target="_blank" rel="noreferrer">View executable source on GitHub ↗</a>
            <code>{scenario.sourcePath}</code>
          </p>
        )}
      </details>
    )}

    <details class="disclosure">
      <summary>Theory reference</summary>
      <p class="reference-note">
        Variables are defined in{" "}
        <a href="/theory/#3-core-definitions">Section 3</a>{" "}
        and models in{" "}
        <a href="/theory/#5-formal-architecture">Section 5</a>{" "}
        of the canonical theory.
      </p>
    </details>
  </div>
</section>

<style>
  .reference-list {
    margin-top: 2rem;
  }

  .reference-note {
    margin: 0;
    color: var(--muted);
    font-size: 0.95rem;
    line-height: 1.55;
  }

  .reference-note a {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-decoration-thickness: 3px;
    text-underline-offset: 3px;
  }

  .field-grid {
    grid-template-columns: repeat(2, 1fr);
    margin: 0;
    border: 1px solid var(--line);
  }

  .reference-note + .field-grid {
    margin-top: 1rem;
  }

  .field-grid > div {
    padding: 1.1rem 1.5rem;
  }

  .field-grid dt {
    color: var(--muted);
    font-size: 0.72rem;
    font-weight: 650;
    letter-spacing: 0.04em;
  }

  .field-grid dt code {
    font-family: ui-monospace, "SF Mono", "Menlo", monospace;
    font-size: 0.85rem;
    letter-spacing: 0;
  }

  .field-grid dd {
    margin: 0.4rem 0 0;
    color: var(--ink);
    font-size: 0.95rem;
  }

  .scenario-source {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.4rem 1rem;
    margin: 1.5rem 0 0;
  }

  .scenario-source a {
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-decoration-thickness: 3px;
    text-underline-offset: 3px;
  }

  .scenario-source code {
    min-width: 0;
    overflow-wrap: anywhere;
    color: var(--muted);
    font-family: ui-monospace, "SF Mono", "Menlo", monospace;
    font-size: 0.85rem;
  }

  @media (max-width: 640px) {
    .field-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
