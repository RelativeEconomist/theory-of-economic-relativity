---
/**
 * The lesson's collapsed reference material: its slotted Model details, then
 * one disclosure with the implementation mapping, source and test links, and
 * theory links.
 */
import type { Scenario } from "../../data/learn/scenarios";

interface Props {
  scenario: Scenario;
  /** Label of the implementation disclosure. */
  summary?: string;
}

const { scenario, summary = "Implementation and references" } = Astro.props;
const githubUrl = (path: string) =>
  `https://github.com/RelativeEconomist/theory-of-economic-relativity/blob/main/${path}`;
---
<section class="scenario-reference doc-section">
  <div class="reference-list">
    <slot />

    <details class="disclosure">
      <summary>{summary}</summary>
      {scenario.implementationNote && <p class="reference-note implementation-note">{scenario.implementationNote}</p>}
      {scenario.implementationMapping && (
        <>
          <p class="reference-note">Python fields in the scenario module and the TER variable each specifies.</p>
          <dl class="field-grid hairline-grid hairline-grid-cols-2">
            {scenario.implementationMapping.map((field) => (
              <div>
                <dt><code>{field.label}</code></dt>
                <dd>{field.value}</dd>
              </div>
            ))}
          </dl>
        </>
      )}
      {scenario.sourcePath && (
        <p class="scenario-source">
          <a href={githubUrl(scenario.sourcePath)} target="_blank" rel="noreferrer">View executable source on GitHub ↗</a>
          <code>{scenario.sourcePath}</code>
        </p>
      )}
      {scenario.testPath && (
        <p class="scenario-source">
          <a href={githubUrl(scenario.testPath)} target="_blank" rel="noreferrer">View the tests on GitHub ↗</a>
          <code>{scenario.testPath}</code>
        </p>
      )}
      <slot name="verification" />
      <p class="reference-note reference-theory">
        Variables are defined in{" "}
        <a href="/theory/#3-core-definitions">Section 3</a>{" "}
        and models in{" "}
        <a href="/theory/#5-formal-architecture">Section 5</a>{" "}
        of the canonical theory.
      </p>
    </details>
  </div>
</section>

<style>
  .reference-list {
    margin-top: 2rem;
  }

  .reference-note {
    margin: 0;
    color: var(--muted);
    font-size: 0.95rem;
    line-height: 1.55;
  }

  .reference-note a {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-decoration-thickness: 3px;
    text-underline-offset: 3px;
  }

  .reference-theory {
    margin-top: 1.5rem;
  }

  /* Whichever item opens the disclosure sits directly under its summary. */
  .implementation-note + .reference-theory {
    margin-top: 1rem;
  }

  summary + .reference-theory,
  summary + .scenario-source {
    margin-top: 0;
  }

  .scenario-source + .scenario-source {
    margin-top: 0.75rem;
  }

  .field-grid {
    grid-template-columns: repeat(2, 1fr);
    margin: 0;
    border: 1px solid var(--line);
  }

  .reference-note + .field-grid {
    margin-top: 1rem;
  }

  .field-grid > div {
    padding: 1.1rem 1.5rem;
  }

  .field-grid dt {
    color: var(--muted);
    font-size: 0.72rem;
    font-weight: 650;
    letter-spacing: 0.04em;
  }

  .field-grid dt code {
    font-family: ui-monospace, "SF Mono", "Menlo", monospace;
    font-size: 0.85rem;
    letter-spacing: 0;
  }

  .field-grid dd {
    margin: 0.4rem 0 0;
    color: var(--ink);
    font-size: 0.95rem;
  }

  .scenario-source {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.4rem 1rem;
    margin: 1.5rem 0 0;
  }

  .scenario-source a {
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-decoration-thickness: 3px;
    text-underline-offset: 3px;
  }

  .scenario-source code {
    min-width: 0;
    overflow-wrap: anywhere;
    color: var(--muted);
    font-family: ui-monospace, "SF Mono", "Menlo", monospace;
    font-size: 0.85rem;
  }

  @media (max-width: 640px) {
    .field-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
