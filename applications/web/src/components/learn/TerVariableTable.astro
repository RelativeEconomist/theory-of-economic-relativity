---
import type { TerComponentMapping } from "../../data/learn/scenarios";
import TerSymbol from "./TerSymbol.astro";

interface Props {
  components: TerComponentMapping[];
}

const { components } = Astro.props;
---
<div class="architecture-table" role="table">
  <div class="architecture-row architecture-head" role="row">
    <span role="columnheader">Component</span>
    <span role="columnheader">Meaning</span>
    <span role="columnheader">In this test</span>
    <span role="columnheader">Test treatment</span>
  </div>
  {components.map((component) => (
    <div class="architecture-row" role="row">
      <span class="component-name" role="cell">
        <b><TerSymbol symbol={component.symbol} /></b> {component.name}
      </span>
      <span class="component-meaning" role="cell">{component.definition}</span>
      <span class="component-mapping" role="cell">{component.mapping}</span>
      <span class="component-treatment" role="cell">{component.testTreatment}</span>
    </div>
  ))}
</div>

<style>
  .architecture-table {
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  .architecture-row {
    display: grid;
    grid-template-columns: 11rem 1fr 1.2fr 12rem;
    gap: 1.5rem;
    padding: 1.25rem 1.5rem;
    border-top: 1px solid var(--line);
  }

  .architecture-row:first-child {
    border-top: none;
  }

  .architecture-head {
    color: var(--muted);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    background: var(--surface-2);
  }

  .component-name {
    font-weight: 650;
  }

  .component-name b {
    display: inline-block;
    min-width: 1.6rem;
    color: var(--muted);
    font-family: ui-monospace, "SF Mono", "Menlo", monospace;
  }

  .component-meaning,
  .component-mapping {
    color: var(--muted);
    font-size: 0.9rem;
    line-height: 1.55;
  }

  .component-treatment {
    color: var(--muted);
    font-size: 0.8rem;
  }

  @media (max-width: 900px) {
    .architecture-row {
      grid-template-columns: 1fr;
      gap: 0.4rem;
    }

    .architecture-head {
      display: none;
    }

    .component-meaning::before {
      content: "Meaning: ";
      color: var(--ink);
    }

    .component-mapping::before {
      content: "In this test: ";
      color: var(--ink);
    }

    .component-treatment::before {
      content: "Test treatment: ";
      color: var(--ink);
    }
  }
</style>
