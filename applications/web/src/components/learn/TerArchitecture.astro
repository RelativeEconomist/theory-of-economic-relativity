---
/**
 * Scenario mapping onto Model 5.1, inside a lesson's Model details: the
 * decision equation and, per variable, its symbol, plain name, role in this
 * test, and any treatment. Single-agent outcome scenarios add the Model 5.2
 * outcome equation; multi-agent scenarios add the Model 5.3 system
 * outcome equation. Each equation links to its model in the theory. The
 * compact view shows treatments as status badges and lists "Not modeled"
 * variables after the rows. Each symbol and name reveals its definition
 * (TerTerm).
 */
import katex from "katex";
import "katex/dist/katex.min.css";
import type { TerComponentMapping } from "../../data/learn/scenarios";
import TerTerm from "./TerTerm.astro";
import Notation from "./Notation.astro";

interface Props {
  components: TerComponentMapping[];
  compact?: boolean;
  /** Interacting agents' actions meet one F_t through one joint R (Model 5.3). */
  multiAgent?: boolean;
  /** One agent's selected action meets F_t through R (Model 5.2). */
  agentOutcome?: boolean;
  /** Render only the equations or only the mapping, for a lesson that puts
   *  text between them. Omitted, both render. */
  part?: "equations" | "mapping";
}

const { components, compact = false, multiAgent = false, agentOutcome = false, part } = Astro.props;
const showEquations = part !== "mapping";
const showMapping = part !== "equations";
const NOT_MODELED = "Not modeled";
const notModeled = compact ? components.filter((component) => component.testTreatment === NOT_MODELED) : [];
const rows = compact ? components.filter((component) => component.testTreatment !== NOT_MODELED) : components;
// Model 5.1 as written in theory/academic.md, rendered at build time. Outer
// parentheses stay at text size so they do not dominate the inline formula.
const decisionEquation = katex.renderToString(
  String.raw`C_{i,t} = D_{i,t}(\hat{F}_{i,t}, M_{i,t}, V_{i,t}(\cdot \mid G_{i,t}, M_{i,t}, H_{i,t}))`,
  { throwOnError: true },
);
// Model 5.2's outcome equation as written in theory/academic.md.
const agentOutcomeEquation = katex.renderToString(String.raw`O_{i,t} = R(C_{i,t}, F_t)`, { throwOnError: true });
// Model 5.3 as written in theory/academic.md.
const systemOutcomeEquation = katex.renderToString(
  String.raw`O_t = R(C_{1,t}, C_{2,t}, \ldots, C_{n,t}, F_t)`,
  { throwOnError: true },
);
---
<div class="ter-architecture">
  {showEquations && <a
    class="equation card"
    href="/theory/#51-agent-decision-model"
    aria-label="Model 5.1, the Agent Decision Model: C sub i,t equals D sub i,t of F-hat sub i,t, M sub i,t, and V sub i,t given G sub i,t, M sub i,t, H sub i,t"
  >
    <span class="formula" set:html={decisionEquation} aria-hidden="true" />
  </a>}

  {showEquations && agentOutcome && (
    <a
      class="equation equation-system card"
      href="/theory/#52-action-to-outcome-model"
      aria-label="Model 5.2, the Action to Outcome Model: O sub i,t equals R of C sub i,t and F sub t"
    >
      <span class="formula" set:html={agentOutcomeEquation} aria-hidden="true" />
    </a>
  )}

  {showEquations && multiAgent && (
    <a
      class="equation equation-system card"
      href="/theory/#53-multi-agent-model"
      aria-label="Model 5.3, the Multi Agent Model: O sub t equals R of C sub 1,t, C sub 2,t, through C sub n,t, and F sub t"
    >
      <span class="formula" set:html={systemOutcomeEquation} aria-hidden="true" />
    </a>
  )}

  {showMapping && <ul class:list={["mapping-list", { compact }]} role="list">
    {rows.map((component) => (
      <li class="mapping-row" data-key={component.key}>
        <span class="term"><TerTerm component={component} /></span>
        <span class="mapping"><Notation text={component.mapping} /></span>
        {component.testTreatment && (compact ? (
          <span class:list={["status", `status-${component.testTreatment.toLowerCase()}`]}>{component.testTreatment}</span>
        ) : (
          <span class="treatment">{component.testTreatment}</span>
        ))}
      </li>
    ))}
  </ul>}

  {showMapping && notModeled.length > 0 && (
    <p class="not-modeled">
      <strong>Not modeled:</strong>{" "}
      {notModeled.map((component, index) => (
        <>{index > 0 && ", "}<TerTerm component={component} symbolOnly /></>
      ))}.
    </p>
  )}
</div>

<style>
  .equation {
    display: flex;
    overflow-x: auto;
    align-items: center;
    margin-top: 2.5rem;
    padding: 1.75rem 2rem;
    color: var(--ink);
  }

  .equation:hover {
    border-color: var(--ink);
  }

  .equation-system {
    margin-top: 1rem;
  }

  .formula {
    font-size: clamp(1rem, 2.4vw, 1.35rem);
    white-space: nowrap;
  }

  .mapping-list {
    margin: 2rem 0 0;
    padding: 0;
    list-style: none;
    border-bottom: 1px solid var(--line);
  }

  .mapping-row {
    display: grid;
    grid-template-columns: 2.5rem 12rem 1fr 11rem;
    align-items: baseline;
    gap: 1rem;
    padding: 0.9rem 0;
    border-top: 1px solid var(--line);
  }

  .compact .mapping-row {
    grid-template-columns: 2.5rem 12rem 1fr auto;
  }

  .term {
    grid-column: span 2;
  }

  .mapping {
    color: var(--muted);
    font-size: 0.95rem;
    line-height: 1.5;
  }

  .treatment {
    color: var(--muted);
    font-size: 0.8rem;
  }

  /* Text carries the status; color only reinforces it. */
  .status {
    padding: 0.2rem 0.6rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--muted);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.04em;
  }

  .status-editable {
    border-color: var(--accent);
    background: var(--accent);
    color: var(--accent-ink);
  }

  .status-output {
    border-color: var(--ink);
    background: var(--ink);
    color: var(--bg);
  }

  .not-modeled {
    margin: 1rem 0 0;
    color: var(--muted);
    font-size: 0.95rem;
  }

  .not-modeled strong {
    color: var(--ink);
  }

  @media (max-width: 640px) {
    .mapping-row {
      grid-template-columns: 2.5rem 1fr;
      gap: 0.3rem 1rem;
    }

    .mapping,
    .treatment {
      grid-column: 2;
    }

    .compact .mapping-row {
      grid-template-columns: 2.5rem 1fr auto;
      gap: 1rem;
    }

    .compact .mapping {
      grid-row: 2;
      grid-column: 2 / -1;
    }

    .status {
      grid-row: 1;
      grid-column: 3;
    }
  }
</style>
