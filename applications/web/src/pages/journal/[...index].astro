---
// The Journal index at /journal/. A rest route (rather than index.astro) so
// the page is built only when there is an article to list: an empty
// Journal is never published.
import { Image } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/PageHero.astro";
import ArticleMeta from "../../components/journal/ArticleMeta.astro";
import { articleTitle, articleUrl, getJournalArticles } from "../../data/journal";

export async function getStaticPaths() {
  const articles = await getJournalArticles();
  return articles.length > 0 ? [{ params: { index: undefined }, props: { articles } }] : [];
}

const { articles } = Astro.props;
---
<BaseLayout
  title="Journal — Theory of Economic Relativity"
  description="Articles and announcements from the Theory of Economic Relativity project."
>
  <PageHero
    title="Journal"
    description="Articles and announcements from the Theory of Economic Relativity project. Journal articles are not peer reviewed."
  />

  <section class="section-sm divider">
    <div class="shell">
      <ol class="journal-list">
        {articles.map((article) => (
          <li class="journal-entry">
            {/* The title link carries the name and keyboard focus; the
                thumbnail repeats it for pointers only. */}
            <a class="journal-thumb" href={articleUrl(article)} tabindex="-1" aria-hidden="true">
              {article.data.cover && (
                <Image src={article.data.cover.src} alt="" widths={[400, 800]} sizes="(max-width: 720px) 100vw, 400px" />
              )}
            </a>
            <div class="journal-text">
              <ArticleMeta article={article} />
              <h2 class="journal-title"><a href={articleUrl(article)}>{articleTitle(article)}</a></h2>
              {article.data.description && <p class="journal-description">{article.data.description}</p>}
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>
</BaseLayout>

<style>
  .journal-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .journal-entry {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
    gap: 2.5rem;
    align-items: start;
    padding-block: 2.5rem;
  }

  .journal-entry:first-child {
    padding-top: 0;
  }

  .journal-entry + .journal-entry {
    border-top: 1px solid var(--line);
  }

  /* Every thumbnail shares one landscape frame, cover or not. */
  .journal-thumb {
    display: block;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: var(--radius-sm);
    background: var(--surface-2);
  }

  .journal-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .journal-entry:has(.journal-title a:focus-visible) .journal-thumb {
    outline: 3px solid var(--violet);
    outline-offset: 4px;
  }

  .journal-text {
    min-width: 0;
  }

  /* The global h3 scale: the h2 scale is for page sections. */
  .journal-title {
    margin-top: 0.75rem;
    font-size: clamp(1.45rem, 2.4vw, 2rem);
    line-height: 1.08;
    overflow-wrap: break-word;
  }

  .journal-title a:hover {
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-decoration-thickness: 3px;
    text-underline-offset: 3px;
  }

  .journal-description {
    max-width: 46rem;
    margin: 0.75rem 0 0;
    color: var(--muted);
    line-height: 1.55;
    text-wrap: pretty;
  }

  @media (max-width: 720px) {
    .journal-entry {
      grid-template-columns: minmax(0, 1fr);
      gap: 1.25rem;
    }
  }
</style>
