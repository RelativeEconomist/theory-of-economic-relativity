---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ScenarioSelector from "../../components/learn/ScenarioSelector.astro";
import ScenarioHeader from "../../components/learn/ScenarioHeader.astro";
import TerArchitecture from "../../components/learn/TerArchitecture.astro";
import ScenarioAssumptions from "../../components/learn/ScenarioAssumptions.astro";
import ScenarioHypotheses from "../../components/learn/ScenarioHypotheses.astro";
import ScenarioResults from "../../components/learn/ScenarioResults.astro";
import ScenarioReference from "../../components/learn/ScenarioReference.astro";
import BasicAgentChoiceRunner from "../../components/learn/BasicAgentChoiceRunner.astro";
import { getActiveScenarios } from "../../data/learn/scenarios";
import type { Scenario } from "../../data/learn/scenarios";

export async function getStaticPaths() {
  return getActiveScenarios().map((scenario) => ({
    params: { slug: scenario.slug },
    props: { scenario },
  }));
}

interface Props {
  scenario: Scenario;
}

const { scenario } = Astro.props;
const activeScenarios = getActiveScenarios();
const scenarioIndex = activeScenarios.findIndex((item) => item.slug === scenario.slug);
const previousScenario = scenarioIndex > 0 ? activeScenarios[scenarioIndex - 1] : undefined;
const nextScenario =
  scenarioIndex >= 0 && scenarioIndex < activeScenarios.length - 1
    ? activeScenarios[scenarioIndex + 1]
    : undefined;

// The interactive scenario pairs the simulator with the compact model view.
const isInteractive = scenario.slug === "basic-agent-choice";
---
<BaseLayout
  title={`${scenario.title} — Learn TER`}
  description={scenario.summary}
>
  <div class="shell">
    <ScenarioHeader scenario={scenario}>
      <ScenarioSelector slot="selector" currentSlug={scenario.slug} />
    </ScenarioHeader>

    <section class="scenario-overview doc-section">
      <h2 class="doc-heading">Scenario</h2>
      <dl class="overview-list">
        {scenario.economicQuestion && (
          <div>
            <dt>Question</dt>
            <dd>{scenario.economicQuestion}</dd>
          </div>
        )}
        <div>
          <dt>Scenario</dt>
          <dd>{scenario.context ?? scenario.summary}</dd>
        </div>
        {scenario.scope && (
          <div>
            <dt>Scope</dt>
            <dd>{scenario.scope}</dd>
          </div>
        )}
      </dl>
    </section>

    {scenario.assumptions && <ScenarioAssumptions assumptions={scenario.assumptions} />}

    {scenario.terComponents && (
      <TerArchitecture components={scenario.terComponents} compact={isInteractive} />
    )}

    {isInteractive && <BasicAgentChoiceRunner />}

    <section class="scenario-interpretation doc-section">
      <h2 class="doc-heading">Interpretation</h2>
      {scenario.economicSetup && <p class="lede">{scenario.economicSetup}</p>}
      {scenario.whatChanges && <p class="lede">{scenario.whatChanges}</p>}
      {scenario.terNote && <p class="ter-note">{scenario.terNote}</p>}
      {scenario.hypotheses && <ScenarioHypotheses hypotheses={scenario.hypotheses} />}
      {(scenario.results || scenario.resultsTable) && (
        <ScenarioResults results={scenario.results} table={scenario.resultsTable} />
      )}
    </section>

    <ScenarioReference scenario={scenario} />

    <section class="section-sm scenario-nav doc-section">
      <div class="scenario-nav-links hairline-grid">
        {previousScenario ? (
          <a href={`/learn/${previousScenario.slug}/`} class="scenario-nav-link">
            <span class="scenario-nav-label">← Previous scenario</span>
            <span class="scenario-nav-title">{previousScenario.title}</span>
          </a>
        ) : (
          <span class="scenario-nav-link is-disabled" aria-disabled="true">
            <span class="scenario-nav-label">← Previous scenario</span>
            <span class="scenario-nav-title">None</span>
          </span>
        )}

        <a href="/learn/" class="scenario-nav-link scenario-nav-all">
          <span class="scenario-nav-label">View all scenarios</span>
        </a>

        {nextScenario ? (
          <a href={`/learn/${nextScenario.slug}/`} class="scenario-nav-link scenario-nav-next">
            <span class="scenario-nav-label">Next scenario →</span>
            <span class="scenario-nav-title">{nextScenario.title}</span>
          </a>
        ) : (
          <span class="scenario-nav-link scenario-nav-next is-disabled" aria-disabled="true">
            <span class="scenario-nav-label">Next scenario →</span>
            <span class="scenario-nav-title">None</span>
          </span>
        )}
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .overview-list {
    margin: 2rem 0 0;
    border-bottom: 1px solid var(--line);
  }

  .overview-list > div {
    display: grid;
    grid-template-columns: 7rem 1fr;
    align-items: baseline;
    gap: 1rem;
    padding: 0.9rem 0;
    border-top: 1px solid var(--line);
  }

  .overview-list dt {
    color: var(--muted);
    font-size: 0.68rem;
    font-weight: 650;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .overview-list dd {
    max-width: 960px;
    margin: 0;
    font-size: 1.05rem;
    line-height: 1.55;
    text-wrap: pretty;
  }

  .scenario-interpretation .lede {
    max-width: 960px;
    margin-top: 1rem;
  }

  .ter-note {
    max-width: 960px;
    margin: 1rem 0 0;
    color: var(--muted);
    font-size: 0.95rem;
    line-height: 1.55;
  }

  .scenario-nav {
    padding-bottom: clamp(4rem, 8vw, 7rem);
    border-top: 1px solid var(--line);
  }

  .scenario-nav-links {
    grid-template-columns: repeat(3, 1fr);
    margin-top: 1.5rem;
    border: 1px solid var(--line);
  }

  .scenario-nav-link {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    padding: 1.25rem 1.5rem;
    color: var(--ink);
  }

  a.scenario-nav-link:hover {
    background: var(--surface);
  }

  .scenario-nav-link.is-disabled {
    color: var(--muted);
  }

  .scenario-nav-label {
    color: var(--muted);
    font-size: 0.68rem;
    font-weight: 650;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .scenario-nav-title {
    font-size: 1rem;
    font-weight: 600;
  }

  .scenario-nav-all {
    align-items: center;
    justify-content: center;
    text-align: center;
  }

  .scenario-nav-next {
    align-items: flex-end;
    text-align: right;
  }

  @media (max-width: 640px) {
    .overview-list > div {
      grid-template-columns: 1fr;
      gap: 0.35rem;
    }

    .scenario-nav-links {
      grid-template-columns: 1fr;
    }

    .scenario-nav-all,
    .scenario-nav-next {
      align-items: flex-start;
      text-align: left;
    }
  }
</style>
