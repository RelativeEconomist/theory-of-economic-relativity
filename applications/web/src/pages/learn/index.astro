---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/PageHero.astro";
import Button from "../../components/ui/Button.astro";
import { scenarios } from "../../data/learn/scenarios";
---
<BaseLayout
  title="Learn — Theory of Economic Relativity"
  description="Explore how familiar economic mechanisms can be represented through TER, one replication test at a time."
>
  <PageHero
    eyebrow="Learn TER"
    title="Learn through economic scenarios."
    description="Explore how familiar economic mechanisms can be represented through TER. Scenarios are arranged as a learning progression. Each scenario connects the economic question, assumptions, TER architecture, executable test, and resulting behavior."
  />

  <section class=""><div class="shell">
    <div class="scenario-grid hairline-grid hairline-grid-cols-2" role="list">
      {scenarios.map((scenario) => {
        const isActive = scenario.status === "active";
        const inner = (
          <>
            <div class="scenario-card-top">
              {scenario.sourceLabel && <span class="test-number">{scenario.sourceLabel}</span>}
              <span class:list={["status-badge", { "is-active": isActive }]}>
                {isActive ? "Active" : "Coming soon"}
              </span>
            </div>
            <h3>{scenario.title}</h3>
            <p>{scenario.summary}</p>
            <span class="category">{scenario.category}</span>
          </>
        );
        return isActive ? (
          <a
            href={`/learn/${scenario.slug}/`}
            class="scenario-card"
            role="listitem"
            data-reveal
          >
            {inner}
          </a>
        ) : (
          <div class="scenario-card is-disabled" role="listitem" aria-disabled="true" data-reveal>
            {inner}
          </div>
        );
      })}
    </div>
  </div></section>
  <section class="section-sm">
    <div class="shell" data-reveal>
  <p class="eyebrow">For researchers and programmers</p>

  <h2>Explore the full theory</h2>

  <p class="lede">
    If you want to review the full theory, inspect the assumptions, or run the executable tests, the complete academic framework and test suite are available in the repository.
  </p>

  <div class="button-row">
    <Button href="/theory/" label="Read the full theory" variant="dark" />
    <Button
      href="https://github.com/RelativeEconomist/theory-of-economic-relativity"
      label="View the tests on GitHub"
      variant="ghost"
      target="_blank"
      rel="noreferrer"
    />
  </div>
  </div>
</section>
  <section class="section-sm"></section>
</BaseLayout>

<style>
  :global(.page-hero h1) {
    max-width: 1100px;
    font-size: clamp(2.75rem, 4.5vw, 5rem);
  }

  .scenario-grid {
    grid-template-columns: repeat(2, 1fr);
    border: 1px solid var(--line);
  }

  .scenario-card {
    display: flex;
    flex-direction: column;
    min-height: 14rem;
    padding: 1.75rem;
    color: var(--ink);
    transition: background-color 0.2s var(--ease);
  }

  a.scenario-card:hover {
    background: var(--surface);
  }

  .scenario-card.is-disabled {
    color: var(--muted);
    cursor: default;
  }

  .scenario-card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .test-number {
    color: var(--muted);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .status-badge {
    padding: 0.3rem 0.6rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--muted);
    font-size: 0.65rem;
    font-weight: 650;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .status-badge.is-active {
    border-color: transparent;
    background: var(--accent);
    color: var(--accent-ink);
  }

  .scenario-card h3 {
    margin-top: 1.75rem;
    font-size: 1.5rem;
  }

  .scenario-card p {
    max-width: 26rem;
    margin: 0.75rem 0 0;
    color: var(--muted);
    font-size: 0.95rem;
    line-height: 1.55;
  }

  .category {
    margin-top: auto;
    padding-top: 1.5rem;
    color: var(--muted);
    font-size: 0.72rem;
    font-weight: 650;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  @media (max-width: 720px) {
    .scenario-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
